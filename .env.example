# All values are server-only. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
# Direct owner connection for migration scripts only; never send to Vercel.
DATABASE_MIGRATION_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Both the immutable Managed Auth user ID and verified email must match.
OWNER_USER_ID=
OWNER_EMAIL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=foundation-checks
# The probe runs only in an isolated environment, never production.
APP_ENV=test
FOUNDATION_CHECK_ENABLED=true
